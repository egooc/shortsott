    { "id": "result_first", "name": "결과 선공개", "needs": ["consequence"], "skeleton": "단 한 번의 {행동}으로 {큰 결과}", "avoid": "결과가 클립 안에서 실제로 보여야 함" },
    { "id": "impossible", "name": "불가능 상황", "needs": ["impossible_situation"], "skeleton": "{출구 없는 상황}에서 살아남는 방법은 하나였다", "avoid": "그 '하나'를 제목에서 밝히지 말 것" },
    { "id": "hidden_identity", "name": "숨겨진 정체", "needs": ["identity", "secret"], "skeleton": "{평범한 겉모습}인 줄 알았는데, 모두가 속고 있었다", "avoid": "정체 자체를 쓰면 스포일러 감점" },
    { "id": "role_reversal", "name": "역할 역전", "needs": ["reversal", "power_gap"], "skeleton": "{쫓던/잡으러 온} {A}가 오히려 {당하는 처지}가 됐다", "avoid": "" },
