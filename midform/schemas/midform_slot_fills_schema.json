{
  "type": "object",
  "properties": {
    "script_id": { "type": "string" },
    "upload_text": {
      "type": "object",
      "properties": {
        "title_candidates": {
          "type": "array",
          "description": "Exactly 3 Korean YouTube title hooks. Each item must be a question-shaped curiosity hook, preferably ending with '?', such as '왜 아버지는 사랑이 의무가 아니라고 했을까?'. Do not output flat declarative summaries.",
          "items": { "type": "string" },
          "minItems": 3,
          "maxItems": 3
        },
        "overlay_title": {
          "type": "object",
          "properties": {
            "top": { "type": "string", "maxLength": 8 },
            "bottom": { "type": "string", "maxLength": 8 }
          },
          "required": ["top", "bottom"],
          "additionalProperties": false
        },
        "description": { "type": "string" },
        "pinned_comment": { "type": "string" }
      },
      "required": ["title_candidates", "overlay_title", "description", "pinned_comment"],
      "additionalProperties": false
    },
    "slot_fills": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "slot_id": { "type": "string" },
          "narration": { "type": "string" },
          "caption_units": {
            "type": "array",
            "items": { "type": "string" }
          },
          "caption_kr": { "type": "string" },
          "caption_kr_dialogue": {
            "type": "array",
            "items": { "type": "string" }
          },
          "speaker": { "type": "string" },
          "speakers": {
            "type": "array",
            "items": { "type": "string" }
          },
          "translation_mode": {
            "type": "string",
            "enum": ["", "faithful_dialogue"]
          }
        },
        "required": [
          "slot_id",
          "narration",
          "caption_units",
          "caption_kr",
          "caption_kr_dialogue",
          "speaker",
          "speakers",
          "translation_mode"
        ],
        "additionalProperties": false
      }
    },
    "quality_check": {
      "type": "object",
      "properties": {
        "all_slots_filled": { "type": "boolean" },
        "slot_order_preserved": { "type": "boolean" },
        "forbidden_eomi_count": { "type": "number" },
        "translationese_risk_count": { "type": "number" },
        "budget_violations": { "type": "number" }
      },
      "required": [
        "all_slots_filled",
        "slot_order_preserved",
        "forbidden_eomi_count",
        "translationese_risk_count",
        "budget_violations"
      ],
      "additionalProperties": false
    }
  },
  "required": ["script_id", "upload_text", "slot_fills", "quality_check"],
  "additionalProperties": false
}
