{
  "type": "object",
  "properties": {
    "script_id": {
      "type": "string"
    },
    "upload_text": {
      "type": "object",
      "properties": {
        "title_candidates": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 3,
          "maxItems": 3
        },
        "overlay_title": {
          "type": "object",
          "properties": {
            "top": {
              "type": "string",
              "maxLength": 8
            },
            "bottom": {
              "type": "string",
              "maxLength": 8
            }
          },
          "required": [
            "top",
            "bottom"
          ],
          "additionalProperties": false
        },
        "description": {
          "type": "string"
        },
        "pinned_comment": {
          "type": "string"
        }
      },
      "required": [
        "title_candidates",
        "overlay_title",
        "description",
        "pinned_comment"
      ],
      "additionalProperties": false
    },
    "slot_fills": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "slot_id": {
            "type": "string"
          },
          "narration": {
            "type": "string"
          },
          "caption_units": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "caption_kr": {
            "type": "string"
          },
          "caption_kr_dialogue": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "speaker": {
            "type": "string"
          },
          "speakers": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "translation_mode": {
            "type": "string",
            "enum": [
              "",
              "faithful_dialogue"
            ]
          },
          "cards": {
            "type": "array",
            "description": "On-screen situation/time-jump cards (benchmark B-form). 1-2 short strings, <=16 Korean chars each. Only for scene-hook cold opens (two situation cards) or a pure time-jump seam (one card like 며칠후). The segment then plays original audio with no TTS.",
            "items": {
              "type": "string"
            },
            "maxItems": 2
          },
          "narration_anchor_secs": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "description": "NARRATE slots only: one source-video second per narration sentence, in sentence order. Each anchor is the moment in the vision scene map that the sentence is written ON - the b-roll clip for that sentence starts there. Empty array for dialogue-only slots."
          },
          "narration_bindings": {
            "type": "array",
            "description": "NARRATE slots: one entry per narration sentence, in order - the render binding that ties the sentence to selected screen evidence. Dialogue-only slots: empty array.",
            "items": {
              "type": "object",
              "properties": {
                "sentence_index": {
                  "type": "integer"
                },
                "event_id": {
                  "type": "string",
                  "description": "evidence event this sentence is written on, or empty for bridge/contextual"
                },
                "narration_type": {
                  "type": "string",
                  "enum": [
                    "literal_action",
                    "contextual_fact",
                    "bridge",
                    "dialogue_setup"
                  ]
                },
                "temporal_phase": {
                  "type": "string",
                  "enum": [
                    "before",
                    "onset",
                    "onset_to_peak",
                    "peak",
                    "result",
                    "whole",
                    "none"
                  ]
                },
                "sync_phrase": {
                  "type": "string",
                  "description": "the Korean verb phrase in this sentence that must land on source_sync_sec (empty when none)"
                },
                "source_sync_sec": {
                  "type": "number"
                },
                "clip_window": {
                  "type": "array",
                  "items": {
                    "type": "number"
                  },
                  "description": "[start_sec, end_sec] of the source clip for this sentence"
                }
              },
              "required": [
                "sentence_index",
                "narration_type",
                "clip_window"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "slot_id",
          "narration",
          "caption_units",
          "caption_kr"
        ],
        "additionalProperties": false
      }
    },
    "quality_check": {
      "type": "object",
      "properties": {
        "all_slots_filled": {
          "type": "boolean"
        },
        "slot_order_preserved": {
          "type": "boolean"
        },
        "forbidden_eomi_count": {
          "type": "number"
        },
        "translationese_risk_count": {
          "type": "number"
        },
        "budget_violations": {
          "type": "number"
        }
      },
      "required": [
        "all_slots_filled",
        "slot_order_preserved",
        "forbidden_eomi_count",
        "translationese_risk_count",
        "budget_violations"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "script_id",
    "upload_text",
    "slot_fills",
    "quality_check"
  ],
  "additionalProperties": false
}